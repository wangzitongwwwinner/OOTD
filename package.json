{
  "name": "ootd-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "test:baseline": "node --test tests",
    "build:weapp": "npm --prefix miniprogram run build:weapp",
    "typecheck:weapp": "npm --prefix miniprogram run typecheck",
    "lint:weapp": "npm --prefix miniprogram run lint",
    "test:weapp": "npm --prefix miniprogram run test",
    "format:weapp": "npm --prefix miniprogram run format",
    "typecheck:contracts": "npm --prefix packages/contracts run typecheck",
    "test:contracts": "npm --prefix packages/contracts run test",
    "typecheck:cloudfunctions": "npm --prefix cloudfunctions/api run typecheck",
    "test:cloudfunctions": "npm --prefix cloudfunctions/api run test",
    "build:cloudfunctions": "npm --prefix cloudfunctions/api run build",
    "quality:tests": "npm run test:baseline && npm run test:weapp && npm run test:contracts && npm run test:cloudfunctions",
    "quality:types": "npm run lint && npm run typecheck:weapp && npm run typecheck:contracts && npm run typecheck:cloudfunctions",
    "quality:builds": "npm run build && npm run build:weapp && npm run build:cloudfunctions",
    "quality": "npm run quality:tests && npm run quality:types && npm run format:weapp && npm run quality:builds",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
