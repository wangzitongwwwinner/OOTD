{
  "name": "@chuanyiyoushu/cloudfunction-api",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/auth/login.test.ts src/location/qweather-city-resolver.test.ts src/location/resolve-city.test.ts src/profile/profile.test.ts src/router.test.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20.19 --format=cjs --minify --external:@cloudbase/node-sdk --outfile=index.js && node scripts/normalize-build.mjs index.js"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "3.18.3"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "esbuild": "0.25.11",
    "tsx": "4.21.0",
    "typescript": "~5.8.2"
  }
}
